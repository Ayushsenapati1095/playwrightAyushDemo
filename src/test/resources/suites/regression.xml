<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression" parallel="classes" thread-count="4" data-provider-thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.ayush.framework.listeners.SuiteListener"/>
        <listener class-name="com.ayush.framework.listeners.TestListener"/>
        <listener class-name="com.ayush.framework.listeners.RetryTransformer"/>
    </listeners>
    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.ayush.tests.api"/>
            <package name="com.ayush.tests.ui"/>
        </packages>
    </test>
</suite>
